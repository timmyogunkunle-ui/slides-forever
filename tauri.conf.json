{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slides Forever",
  "version": "1.0.0",
  "identifier": "com.slidesforever.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Slides Forever",
        "url": "index.html",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
